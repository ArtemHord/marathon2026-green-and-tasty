{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run test:hw)",
      "Bash(npx tsc:*)",
      "Bash(npx ng test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(scripts/smoke.sh)",
      "Bash(scripts/check-prereqs.sh)"
    ],
    "deny": [
      "Bash(scripts/destroy.sh:*)",
      "Bash(terraform destroy:*)",
      "Bash(syndicate clean:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3api delete-bucket:*)",
      "Bash(aws dynamodb delete-table:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.tfvars)"
    ]
  }
}
